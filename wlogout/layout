{
    "label" : "lock",
    "action" : "loginctl lock-session",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "pw-play ~/Music/samsung-winxp/stereo/service-logout.ogg; hyprctl dispatch 'hl.dsp.exit()'; niri msg action quit; mmsg dispatch quit",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "pw-play ~/Music/samsung-winxp/stereo/service-logout.ogg; systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "pw-play ~/Music/samsung-winxp/stereo/service-logout.ogg; systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend",
    "keybind" : "d"
}
